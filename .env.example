# LLM protocol: openai-compatible (/chat/completions) or anthropic (/messages).
# 复制此文件为项目根目录 .env，填写后重启 run.cmd。
# 空配置使用本地规则回复。不要在此模板填写真实 Key。
DIGITALHELPER_LLM_PROTOCOL=openai-compatible
DIGITALHELPER_LLM_API_KEY=
# 服务商提供的 Base URL，不包含 /chat/completions。
DIGITALHELPER_LLM_BASE_URL=
DIGITALHELPER_LLM_MODEL=

# TTS: edge or openai-compatible. Base URL includes /v1, excludes /audio/speech.
DIGITALHELPER_TTS_PROTOCOL=edge
DIGITALHELPER_TTS_API_KEY=
DIGITALHELPER_TTS_BASE_URL=
DIGITALHELPER_TTS_MODEL=
DIGITALHELPER_TTS_VOICE_MALE=
DIGITALHELPER_TTS_VOICE_FEMALE=
DIGITALHELPER_TTS_EDGE_VOICE_MALE=zh-CN-YunxiNeural
DIGITALHELPER_TTS_EDGE_VOICE_FEMALE=zh-CN-XiaoxiaoNeural
